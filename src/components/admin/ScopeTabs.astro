---
// 汽車／機車切換。車廠、車型、車輛三個頁面共用同一組 ?type= 語意，
// 所以切換器也共用一個 —— 三頁的位置與外觀一致，才不用重新找。
import { VEHICLE_TYPE } from '../../lib/enums';

interface Props {
  /** 不含 query 的路徑，例如 /admin/vehicles */
  base: string;
  current: number;
  /**
   * 這個管理員有權讀取的車種（auth.ts viewableTypes）。只有一種時整組
   * 切換器就不出現 —— 顯示一個按下去會 403 的頁籤沒有意義。
   */
  types: number[];
}

const { base, current, types } = Astro.props;
const LABEL: Record<number, string> = { [VEHICLE_TYPE.CAR]: '汽車', [VEHICLE_TYPE.BIKE]: '機車' };
const tabs = [VEHICLE_TYPE.CAR, VEHICLE_TYPE.BIKE].filter((t) => types.includes(t));
---

{
  tabs.length > 1 && (
    <div class="tm-scope" role="group" aria-label="車種">
      {tabs.map((t) => (
        <a href={`${base}?type=${t}`} aria-current={current === t ? 'page' : undefined}>
          {LABEL[t]}
        </a>
      ))}
    </div>
  )
}
