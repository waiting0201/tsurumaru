---
// 後台版型 —— 全新設計，不沿用舊 SmartAdmin 樣板（ADR-0005）。
//
// 設計方向：「臺帳」。中古車行的在庫表單 —— 細框線、無圓角、
// 等寬字的小型大寫欄位標籤、數字一律對齊。朱紅（前台主色 #fd5631）
// 是唯一的重點色，只用在目前所在的選單、主要動作、必填記號三處。
// 版面語彙見 src/styles/admin.css。
//
// 選單寫在程式碼裡，不再從 permissions 表動態產生 —— 舊版讓那張表同時
// 扮演選單與權限兩種角色，職責混淆。
//
// 排版全程不需要 JavaScript：手機版選單用 <details>，不引入任何前端狀態。
import type { AuthedAdmin } from '../lib/auth';
import '../styles/admin.css';

interface Props {
  title: string;
  admin: AuthedAdmin;
  csrf: string;
}

const { title, admin, csrf } = Astro.props;
const path = Astro.url.pathname;

// code 是印在頁面抬頭的區段代號。它不是裝飾 —— 頁標題常常帶著
// 「— 汽車」這類範圍後綴，代號讓人一眼確認自己在哪一個區段。
const NAV = [
  { href: '/admin', code: 'OVERVIEW', label: '總覽' },
  { href: '/admin/vehicles', code: 'VEHICLES', label: '車輛' },
  { href: '/admin/makes', code: 'MAKES', label: '車廠' },
  { href: '/admin/models', code: 'MODELS', label: '車型' },
  { href: '/admin/admins', code: 'ADMINS', label: '管理員' },
];

const active = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
const current = NAV.find((n) => active(n.href));
const who = admin.name ?? admin.username;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{title}｜Tsurumaru 後台</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-white"
      >跳到主要內容</a
    >

    <!-- ── 側欄 ───────────────────────────────────────────────────────── -->
    <aside
      class="border-b border-rail-rule bg-rail lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-60 lg:flex-col lg:border-r lg:border-b-0"
    >
      <!-- checkbox 放在最前面，後面的兄弟元素才能用 peer-checked / focus-visible
           選到（樣式見 admin.css）。桌機版側欄一直展開，它只在手機版有作用。 -->
      <input type="checkbox" id="tm-nav" class="peer sr-only" />

      <div class="flex items-center gap-3 px-5 py-4 lg:py-5">
        <span class="mt-0.5 size-2.5 shrink-0 bg-stamp" aria-hidden="true"></span>
        <span class="min-w-0">
          <span class="block font-mono text-[15px] leading-none font-medium tracking-[0.18em] text-white"
            >TSURUMARU</span
          >
          <span class="mt-1.5 block text-[11px] leading-none tracking-[0.2em] text-rail-text">在庫管理</span>
        </span>

        <!-- 手機版：選單開合。桌機版側欄一直在，就不需要這顆。 -->
        <label
          for="tm-nav"
          class="ml-auto cursor-pointer border border-rail-rule px-2.5 py-1.5 font-mono text-[11px] tracking-[0.1em] text-rail-text lg:hidden"
        >
          選單
        </label>
      </div>

      <div class="hidden peer-checked:block lg:flex lg:min-h-0 lg:flex-1 lg:flex-col">
        <nav class="pb-3 lg:flex-1 lg:pb-0" aria-label="後台主選單">
          {
            NAV.map((n) => (
              <a class="tm-nav-link" href={n.href} aria-current={active(n.href) ? 'page' : undefined}>
                <span class="mr-2 flex-1">{n.label}</span>
                <span class="font-mono text-[10px] tracking-[0.12em] text-rail-text/70 uppercase">{n.code}</span>
              </a>
            ))
          }
        </nav>

        <!-- 帳號與登出釘在側欄底部：它們是「離開」的動作，不該混在導覽裡 -->
        <div class="mt-auto border-t border-rail-rule px-5 py-4">
          <p class="truncate text-[13px] text-white" title={who}>{who}</p>
          <p class="tm-eyebrow mt-1 text-rail-text/70">
            {admin.isSuper ? '超級管理員' : '一般管理員'}
          </p>
          <div class="mt-3 flex items-center gap-3">
            <form method="post" action="/admin/logout">
              <input type="hidden" name="csrf" value={csrf} />
              <button
                type="submit"
                class="cursor-pointer border border-rail-rule px-2.5 py-1.5 text-[13px] leading-none text-rail-text transition-colors hover:border-stamp hover:text-white"
                >登出</button
              >
            </form>
            <a
              href="/"
              target="_blank"
              rel="noopener"
              class="text-[13px] text-rail-text underline-offset-4 transition-colors hover:text-white hover:underline"
              >開啟前台 ↗</a
            >
          </div>
        </div>
      </div>
    </aside>

    <!-- ── 內容 ───────────────────────────────────────────────────────── -->
    <div class="min-h-screen lg:pl-60">
      <header class="sticky top-0 z-30 border-b border-rule bg-white/95 px-4 py-3.5 backdrop-blur sm:px-6">
        <div class="mx-auto flex max-w-6xl flex-wrap items-end gap-x-4 gap-y-2">
          <div class="min-w-0">
            {current && <p class="tm-eyebrow">{current.code}</p>}
            <h1 class="mt-1 text-[19px] leading-tight font-medium tracking-tight text-ink">{title}</h1>
          </div>
          <div class="ml-auto flex flex-wrap items-center gap-2">
            <slot name="actions" />
          </div>
        </div>
      </header>

      <main id="main" class="mx-auto max-w-6xl px-4 py-5 sm:px-6 sm:py-6">
        <slot />
      </main>
    </div>
  </body>
</html>
