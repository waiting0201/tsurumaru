---
// 對應 reference/old/Tsurumaru/Views/Shared/_Layout.cshtml
//   ＋ _Styles.cshtml（head 尾端）＋ _Scripts.cshtml（body 尾端）
//
// DOM、class、vendor 載入順序完全照搬（紅線一，見 docs/04-conventions.md）。
// 唯一新增的是 <head> 的 SEO 標籤 —— 屬於明確允許改動的範圍。
// 舊版所有頁面共用同一個寫死的 title，對 SEO 不利。
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** og:image 等社群分享用的絕對網址 */
  image?: string;
}

const {
  title = 'TSURUMARU｜日本二手車',
  description = '鶴丸株式会社 — 日本中古車與中古重機的引進與販售。',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{title}</title>
    <!-- SEO Meta Tags-->
    <meta name="description" content={description}>
    <meta name="keywords" content="">
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    {image && <meta property="og:image" content={image} />}
    <!-- Viewport-->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Favicon and Touch Icons-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;800&display=swap" rel="stylesheet">
    <meta name="msapplication-TileColor" content="#766df4">
    <meta name="theme-color" content="#ffffff">
    <!-- Page loading styles-->
    <style is:inline>
      .page-loading {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        -webkit-transition: all .4s .2s ease-in-out;
        transition: all .4s .2s ease-in-out;
        background-color: #1f1b2d;
        opacity: 0;
        visibility: hidden;
        z-index: 9999;
      }
      .page-loading.active {
        opacity: 1;
        visibility: visible;
      }
      .page-loading-inner {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        text-align: center;
        -webkit-transform: translateY(-50%);
        transform: translateY(-50%);
        -webkit-transition: opacity .2s ease-in-out;
        transition: opacity .2s ease-in-out;
        opacity: 0;
      }
      .page-loading.active > .page-loading-inner {
        opacity: 1;
      }
      .page-loading-inner > span {
        display: block;
        font-size: 1rem;
        font-weight: normal;
        color: #fff;;
      }
      .page-spinner {
        display: inline-block;
        width: 2.75rem;
        height: 2.75rem;
        margin-bottom: .75rem;
        vertical-align: text-bottom;
        border: .15em solid #9691a4;
        border-right-color: transparent;
        border-radius: 50%;
        -webkit-animation: spinner .75s linear infinite;
        animation: spinner .75s linear infinite;
      }
      @-webkit-keyframes spinner {
        100% {
          -webkit-transform: rotate(360deg);
          transform: rotate(360deg);
        }
      }
      @keyframes spinner {
        100% {
          -webkit-transform: rotate(360deg);
          transform: rotate(360deg);
        }
      }

    </style>
    <!-- Page loading scripts-->
    <script is:inline>
        (function () {
            window.onload = function () {
                var preloader = document.querySelector('.page-loading');
                preloader.classList.remove('active');
                setTimeout(function () {
                    preloader.remove();
                }, 2000);
            };
        })();
    </script>
    <!-- Vendor Styles-->
    <link rel="stylesheet" media="screen" href="/scripts/vendor/simplebar/dist/simplebar.min.css" />
    <link rel="stylesheet" media="screen" href="/scripts/vendor/tiny-slider/dist/tiny-slider.css" />
    <link rel="stylesheet" media="screen" href="/scripts/vendor/nouislider/dist/nouislider.min.css">
    <!-- Main Theme Styles + Bootstrap-->
    <link rel="stylesheet" media="screen" href="/content/css/theme.css">
</head>
<!-- Body-->
<body class="bg-light">
    <!-- Page loading spinner-->
    <div class="page-loading active">
        <div class="page-loading-inner">
            <div class="page-spinner"></div><span>Loading...</span>
        </div>
    </div>
    <main class="page-wrapper">
        <Header />
        <slot />
    </main>
    <Footer />
    <!-- Back to top button--><a class="btn-scroll-top" href="#top" data-scroll><span class="btn-scroll-top-tooltip text-muted fs-sm me-2">Top</span><i class="btn-scroll-top-icon fi-chevron-up">   </i></a>
    <!-- Vendor scrits: js libraries and plugins-->
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <script is:inline src="/scripts/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/scripts/vendor/simplebar/dist/simplebar.min.js"></script>
    <script is:inline src="/scripts/vendor/smooth-scroll/dist/smooth-scroll.polyfills.min.js"></script>
    <script is:inline src="/scripts/vendor/tiny-slider/dist/min/tiny-slider.js"></script>
    <script is:inline src="/scripts/vendor/jarallax/dist/jarallax.min.js"></script>
    <script is:inline src="/scripts/vendor/jarallax/dist/jarallax-element.min.js"></script>
    <script is:inline src="/scripts/vendor/lightgallery.js/dist/js/lightgallery.min.js"></script>
    <script is:inline src="/scripts/vendor/lg-video.js/dist/lg-video.min.js"></script>
    <script is:inline src="/scripts/vendor/nouislider/dist/nouislider.min.js"></script>
    <!-- Main theme script-->
    <script is:inline src="/scripts/js/theme.min.js"></script>
    <slot name="scripts" />
</body>
</html>
