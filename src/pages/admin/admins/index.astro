---
// 管理員與權限維護。對應舊版 SettingMsController。
//
// 與舊版的差異：
//   • 密碼存 PBKDF2 雜湊；後台看不到、也存不進明碼
//   • 超級管理員改為資料庫旗標 is_super，取代硬編碼的 AdminID=888
//   • 權限節點涵蓋相簿（舊版遺漏）
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import Flash from '../../../components/admin/Flash.astro';
import Field from '../../../components/admin/Field.astro';
import { requireView, requireCan, requirePost, handleGuard, str, int } from '../../../lib/admin-guard';
import { csrfToken, RESOURCES, can, hashPassword } from '../../../lib/auth';
import {
  listAdmins, getAdmin, insertAdmin, updateAdminInfo, updateAdminPassword, deleteAdmin,
  allPermissions, adminPermissionMap, setAdminPermissions,
} from '../../../lib/admin-db';

export const prerender = false;

// 依業主決定，後台密碼不設最短長度限制（2026-08-07）。
// 空字串仍然拒絕 —— 那不是「短密碼」而是「沒有密碼」。
// 見 docs/08-security.md#密碼

let admin, csrf, admins, permissions, mayAdd = false, mayUpdate = false, mayDelete = false;
let editing = null, editingPerms = new Map();
let err = '', msg = '';

try {
  admin = await requireView(Astro, RESOURCES.ADMINS);
  csrf = await csrfToken(admin.sessionId);

  if (Astro.request.method === 'POST') {
    const form = await requirePost(Astro, admin);
    const action = str(form, 'action');

    if (action === 'create') {
      await requireCan(Astro, RESOURCES.ADMINS, 'add');
      const username = str(form, 'username'), password = str(form, 'password');
      if (!username || !password) err = '帳號與密碼都是必填。';
      else {
        try {
          await insertAdmin(str(form, 'name') || null, username, await hashPassword(password),
            str(form, 'email') || null, str(form, 'is_super') === '1' ? 1 : 0);
          msg = `已新增管理員「${username}」。`;
        } catch { err = '該帳號已存在。'; }
      }
    } else if (action === 'update') {
      await requireCan(Astro, RESOURCES.ADMINS, 'update');
      const id = int(form, 'id');
      const target = id ? await getAdmin(id) : null;
      if (!target) err = '找不到該管理員。';
      else {
        await updateAdminInfo(target.id, str(form, 'name') || null, str(form, 'email') || null,
          str(form, 'is_super') === '1' ? 1 : 0);
        const password = str(form, 'password');
        if (password) await updateAdminPassword(target.id, await hashPassword(password));
        const perms = (await allPermissions()).map((p) => ({
          permissionId: p.id,
          add: form.get(`perm_${p.id}_add`) === '1',
          update: form.get(`perm_${p.id}_update`) === '1',
          delete: form.get(`perm_${p.id}_delete`) === '1',
        }));
        await setAdminPermissions(target.id, perms);
        if (!err) msg = '已更新。';
      }
    } else if (action === 'delete') {
      await requireCan(Astro, RESOURCES.ADMINS, 'delete');
      const id = int(form, 'id');
      if (!id) err = '找不到該管理員。';
      else if (id === admin.id) err = '不能刪除自己的帳號。';
      else { await deleteAdmin(id); msg = '已刪除。'; }
    }
  }

  [admins, permissions, mayAdd, mayUpdate, mayDelete] = await Promise.all([
    listAdmins(),
    allPermissions(),
    can(admin, RESOURCES.ADMINS, 'add'),
    can(admin, RESOURCES.ADMINS, 'update'),
    can(admin, RESOURCES.ADMINS, 'delete'),
  ]);

  const editId = Number(Astro.url.searchParams.get('edit')) || 0;
  if (editId) {
    editing = admins.find((a) => a.id === editId) ?? null;
    if (editing) editingPerms = await adminPermissionMap(editing.id);
  }
} catch (e) {
  return handleGuard(e);
}

const parentName = (id: number | null) => permissions.find((p) => p.id === id)?.value ?? '';
const permOf = (id: number) => editingPerms.get(id) ?? { add: false, update: false, delete: false };

// 權限節點是兩層的。按上層分組後再列，表格才看得出「哪個資源的哪個動作」，
// 而不是一整片沒有層次的核取方塊。
const grouped = new Map<string, typeof permissions>();
for (const p of permissions) {
  if (p.parent_id === null) continue;
  const key = parentName(p.parent_id);
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(p);
}
const groups = [...grouped.entries()];

const ACTION_LABEL = { add: '新增', update: '修改', delete: '刪除' } as const;
---

<Admin title="管理員維護" admin={admin} csrf={csrf}>
  <Flash err={err} msg={msg} />

  <div class="space-y-5">
    <Panel title="管理員帳號" flush>
      <span class="font-mono text-[12px] text-ink-mute" slot="head">{admins.length} 人</span>

      <div class="overflow-x-auto">
        <table class="tm-table">
          <thead>
            <tr>
              <th class="w-44">帳號</th>
              <th class="w-36">姓名</th>
              <th>Email</th>
              <th class="w-32">角色</th>
              <th class="w-24 text-right">操作</th>
            </tr>
          </thead>
          <tbody>
            {admins.map((a) => (
              <tr class:list={[editing?.id === a.id && 'bg-paper']}>
                <td>
                  <span class="font-mono text-[13px] font-medium text-ink">{a.username}</span>
                  {a.id === admin.id && <span class="ml-2 text-[12px] text-ink-mute">（你）</span>}
                  {/* 密碼雜湊以 ! 開頭 = 還沒設過密碼，這個帳號登不進來 */}
                  {a.password_hash.startsWith('!') && (
                    <span class="mt-1 flex w-fit items-center gap-1.5 border border-stamp/40 bg-stamp/8 px-1.5 py-0.5 font-mono text-[10px] tracking-[0.1em] text-stamp-ink uppercase">
                      尚未設定密碼
                    </span>
                  )}
                </td>
                <td class="text-ink-soft">{a.name || <span class="text-ink-mute">—</span>}</td>
                <td class="text-ink-soft">{a.email || <span class="text-ink-mute">—</span>}</td>
                <td>
                  {a.is_super === 1 ? (
                    <span class="inline-flex items-center gap-1.5 text-[13px] font-medium text-ink">
                      <span class="size-1.5 bg-stamp" aria-hidden="true" />超級管理員
                    </span>
                  ) : (
                    <span class="text-[13px] text-ink-mute">一般</span>
                  )}
                </td>
                <td class="text-right">
                  {mayUpdate && <a class="tm-btn tm-btn--ghost tm-btn--sm" href={`?edit=${a.id}#edit`}>編輯</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Panel>

    {mayUpdate && editing && (
      <Panel title={`編輯 — ${editing.username}`} class="scroll-mt-24" id="edit">
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" value={editing.id} />

          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <Field label="姓名" for="e-name">
              <input id="e-name" name="name" type="text" value={editing.name ?? ''} />
            </Field>
            <Field label="Email" for="e-email">
              <input id="e-email" name="email" type="email" value={editing.email ?? ''} />
            </Field>
            <Field label="新密碼" for="e-pw" hint="留空表示不變更。">
              <input id="e-pw" name="password" type="password" autocomplete="new-password" />
            </Field>
            <Field label="角色" for="e-super">
              <select id="e-super" name="is_super">
                <option value="0" selected={editing.is_super !== 1}>一般管理員</option>
                <option value="1" selected={editing.is_super === 1}>超級管理員</option>
              </select>
            </Field>
          </div>

          {/* ── 權限 ─────────────────────────────────────────────────── */}
          <div class="mt-6 border border-rule">
            <div class="tm-panel-head">
              <h3 class="tm-panel-title">權限</h3>
              <p class="text-[13px] text-ink-mute">
                {editing.is_super === 1
                  ? '這個帳號是超級管理員，擁有全部權限，下表不生效。'
                  : '沒有勾選的動作，這個帳號按下去會被拒絕。'}
              </p>
            </div>

            <div class="overflow-x-auto">
              <table class="tm-table">
                <thead>
                  <tr>
                    <th>資源</th>
                    <th class="w-24 text-center">新增</th>
                    <th class="w-24 text-center">修改</th>
                    <th class="w-24 text-center">刪除</th>
                  </tr>
                </thead>
                {groups.map(([group, leaves]) => (
                  <tbody>
                    <tr>
                      <th colspan="4" class="border-b border-rule bg-paper/60 px-3 py-1.5 text-left">
                        <span class="tm-eyebrow">{group}</span>
                      </th>
                    </tr>
                    {leaves.map((p) => {
                      const cur = permOf(p.id);
                      return (
                        <tr>
                          <td class="pl-6 text-ink">{p.value}</td>
                          {(['add', 'update', 'delete'] as const).map((act) => (
                            <td class="text-center">
                              <input
                                class="size-4 cursor-pointer accent-stamp"
                                type="checkbox"
                                name={`perm_${p.id}_${act}`}
                                value="1"
                                checked={cur[act]}
                                aria-label={`${group} ${p.value} — ${ACTION_LABEL[act]}`}
                              />
                            </td>
                          ))}
                        </tr>
                      );
                    })}
                  </tbody>
                ))}
              </table>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button class="tm-btn" type="submit">儲存變更</button>
            <a class="tm-btn tm-btn--ghost" href="/admin/admins">取消</a>
          </div>
        </form>

        {mayDelete && editing.id !== admin.id && (
          <form
            method="post"
            class="mt-4 flex flex-wrap items-center gap-3 border-t border-rule pt-4"
            onsubmit="return confirm('刪除這個管理員帳號？')"
          >
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={editing.id} />
            <button class="tm-btn tm-btn--danger tm-btn--sm" type="submit">刪除這個帳號</button>
          </form>
        )}
      </Panel>
    )}

    {mayAdd && (
      <Panel title="新增管理員">
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="create" />

          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            <Field label="帳號" for="c-username" required numeric hint="登入用，建立後不能改。">
              <input id="c-username" name="username" type="text" autocomplete="off" required />
            </Field>
            <Field label="密碼" for="c-pw" required>
              <input id="c-pw" name="password" type="password" autocomplete="new-password" required />
            </Field>
            <Field label="角色" for="c-super">
              <select id="c-super" name="is_super">
                <option value="0">一般管理員</option>
                <option value="1">超級管理員</option>
              </select>
            </Field>
            <Field label="姓名" for="c-name">
              <input id="c-name" name="name" type="text" />
            </Field>
            <Field label="Email" for="c-email">
              <input id="c-email" name="email" type="email" />
            </Field>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button class="tm-btn" type="submit">新增管理員</button>
            <span class="text-[13px] text-ink-mute">一般管理員建立後沒有任何權限，請接著在編輯畫面指派。</span>
          </div>
        </form>
      </Panel>
    )}
  </div>
</Admin>
