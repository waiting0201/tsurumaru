---
// 後台總覽。對應舊版 MainController.Index。
//
// 舊版是六個一模一樣的方塊。這裡按「多久會動一次」分層：
// 在庫（每天都在改）→ 主檔（偶爾維護）→ 帳號。
// 分層本身就是資訊 —— 它告訴人每天該從哪裡開始。
import Admin from '../../layouts/Admin.astro';
import Panel from '../../components/admin/Panel.astro';
import { requireAdmin, handleGuard } from '../../lib/admin-guard';
import { csrfToken, RESOURCES, can, canView, resourceFor, viewableTypes } from '../../lib/auth';
import { dashboardStats } from '../../lib/admin-db';
import { VEHICLE_TYPE } from '../../lib/enums';

export const prerender = false;

// 總覽只呼叫 requireAdmin，所以每一個數字都必須自己比對權限 ——
// 否則沒有任何權限的帳號雖然進不去各資源頁，卻能在這裡看到全部筆數。
let admin, csrf, stats;
let vehicleTypes: number[] = [], makeTypes: number[] = [], modelTypes: number[] = [];
let mayViewPhotos = false, mayViewAdmins = false;
try {
  admin = await requireAdmin(Astro);
  csrf = await csrfToken(admin.sessionId);
  [stats, vehicleTypes, makeTypes, modelTypes, mayViewPhotos, mayViewAdmins] = await Promise.all([
    dashboardStats(),
    viewableTypes(admin, 'vehicles'),
    viewableTypes(admin, 'makes'),
    viewableTypes(admin, 'models'),
    canView(admin, RESOURCES.PHOTOS),
    canView(admin, RESOURCES.ADMINS),
  ]);
} catch (e) {
  return handleGuard(e);
}

const n = (v: number | undefined) => (v ?? 0).toLocaleString('en-US');

const stock = [
  { label: '汽車', code: 'CARS', n: stats?.cars ?? 0, type: VEHICLE_TYPE.CAR },
  { label: '機車', code: 'BIKES', n: stats?.bikes ?? 0, type: VEHICLE_TYPE.BIKE },
].filter((s) => vehicleTypes.includes(s.type));

const master = [
  { label: '車廠', n: stats?.makes ?? 0, href: `/admin/makes?type=${makeTypes[0]}`, show: makeTypes.length > 0 },
  { label: '車型', n: stats?.models ?? 0, href: `/admin/models?type=${modelTypes[0]}`, show: modelTypes.length > 0 },
  { label: '相片', n: stats?.photos ?? 0, href: '/admin/vehicles', show: mayViewPhotos },
  { label: '管理員', n: stats?.admins ?? 0, href: '/admin/admins', show: mayViewAdmins },
].filter((m) => m.show);

// 新增車輛的按鈕，依車種分別判斷
const addable = await Promise.all(
  vehicleTypes.map(async (t) => ({
    type: t,
    label: t === VEHICLE_TYPE.CAR ? '汽車' : '機車',
    ok: await can(admin, resourceFor('vehicles', t), 'add'),
  })),
);
const mayAdd = addable.filter((a) => a.ok);
---

<Admin title="總覽" admin={admin} csrf={csrf}>
  <div class="space-y-5">
    <!-- ── 在庫 ─────────────────────────────────────────────────────────
         每天真正在動的數字，給它們最大的字級與整個面板的寬度。
         只顯示這個管理員有權讀取的車種。 -->
    {stock.length > 0 && (
    <Panel title="在庫" flush>
      <!-- gap-px + 底色 = 細格線，不用逐格算 border 該加在哪一邊 -->
      <div class="grid gap-px bg-rule sm:grid-cols-2">
        {
          stock.map((s) => (
            <a
              href={`/admin/vehicles?type=${s.type}`}
              class="group relative flex items-baseline gap-4 bg-white px-5 py-6 transition-colors hover:bg-paper"
            >
              <span class="absolute inset-y-4 left-0 w-0.5 bg-transparent transition-colors group-hover:bg-stamp" />
              <span class="font-mono text-[40px] leading-none font-medium tracking-tight text-ink tabular-nums">
                {n(s.n)}
              </span>
              <span>
                <span class="block text-[15px] font-medium text-ink">{s.label}</span>
                <span class="tm-eyebrow mt-0.5 block">{s.code}</span>
              </span>
              <span class="ml-auto self-center text-[13px] text-ink-mute transition-colors group-hover:text-ink">
                檢視 →
              </span>
            </a>
          ))
        }
      </div>
    </Panel>
    )}

    <!-- ── 主檔 ───────────────────────────────────────────────────────── -->
    {master.length > 0 && (
    <Panel title="主檔與帳號" flush>
      <dl class="grid grid-cols-2 gap-px bg-rule sm:grid-cols-4">
        {
          master.map((m) => (
            <a href={m.href} class="flex flex-col gap-1 bg-white px-4 py-4 transition-colors hover:bg-paper">
              <dt class="tm-eyebrow">{m.label}</dt>
              <dd class="font-mono text-[22px] leading-none font-medium text-ink tabular-nums">{n(m.n)}</dd>
            </a>
          ))
        }
      </dl>
    </Panel>
    )}

    <!-- ── 常用動作 ────────────────────────────────────────────────────
         按鈕名稱就是它會做的事，跟目的地頁面的標題一致。 -->
    {
      mayAdd.length > 0 && (
        <Panel title="新增一台車">
          <div class="flex flex-wrap gap-2">
            {mayAdd.map((a) => (
              <a class="tm-btn" href={`/admin/vehicles/edit?type=${a.type}`}>
                新增{a.label}
              </a>
            ))}
          </div>
          <p class="tm-field-hint">相片在車輛存檔後，從該車的「相簿」上傳。</p>
        </Panel>
      )
    }

    {stock.length === 0 && master.length === 0 && (
      <Panel title="沒有可用的功能">
        <p class="text-[15px] text-ink">這個帳號還沒有被指派任何權限。</p>
        <p class="tm-field-hint">請有「管理者維護」權限的人在管理員頁面指派。</p>
      </Panel>
    )}
  </div>
</Admin>
