---
// 後台登入。對應舊版 MainController.Login。
//
// 與舊版的差異（docs/08-security.md）：
//   • 沒有任何硬編碼帳號 —— 唯一的驗證路徑是資料庫
//   • 密碼比對走 PBKDF2 + 固定時間比較
//   • 登入成功後換發新 session id（避免 session fixation）
//   • 錯誤訊息不區分「帳號不存在」與「密碼錯誤」
import { login, createSession, sessionCookie, getSessionAdmin, needsPasswordReset } from '../../lib/auth';
import { env } from 'cloudflare:workers';
import '../../styles/admin.css';

export const prerender = false;

let error = '';
const nextUrl = Astro.url.searchParams.get('next') ?? '/admin';
const secure = Astro.url.protocol === 'https:';

// 已登入就直接進後台
const existing = await getSessionAdmin(Astro.request.headers.get('cookie'));
if (existing && Astro.request.method === 'GET') {
  return Astro.redirect('/admin', 302);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const username = String(form.get('username') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!username || !password) {
    error = '請輸入帳號與密碼。';
  } else {
    const admin = await login(username, password);
    if (!admin) {
      // 區分「密碼錯」與「這個帳號的雜湊參數已無法驗證」——後者無論輸入什麼
      // 密碼都會失敗，講「密碼不正確」會把人引導到完全錯誤的方向。
      const row = await env.DB.prepare('SELECT password_hash FROM admins WHERE username = ?')
        .bind(username).first<{ password_hash: string }>();
      error = row && needsPasswordReset(row.password_hash)
        ? '這個帳號的密碼是用舊的雜湊參數建立的，無法驗證，必須重設。請執行：node scripts/set-admin-password.mjs ' + username + ' --remote'
        : '帳號或密碼不正確。';
    } else {
      const session = await createSession(admin.id);
      const target = nextUrl.startsWith('/admin') ? nextUrl : '/admin';
      return new Response(null, {
        status: 302,
        headers: { location: target, 'set-cookie': sessionCookie(session.id, secure) },
      });
    }
  }
}
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>登入｜Tsurumaru 後台</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
  </head>

  <body class="grid min-h-screen place-items-center p-4">
    <main class="w-full max-w-sm">
      <div class="tm-panel">
        <!-- 抬頭沿用側欄的深色與朱印，登入畫面與後台是同一個地方 -->
        <header class="flex items-center gap-3 bg-rail px-5 py-4">
          <span class="size-2.5 shrink-0 bg-stamp" aria-hidden="true"></span>
          <span>
            <span class="block font-mono text-[15px] leading-none font-medium tracking-[0.18em] text-white"
              >TSURUMARU</span
            >
            <span class="mt-1.5 block text-[11px] leading-none tracking-[0.2em] text-rail-text">在庫管理</span>
          </span>
        </header>

        <form method="post" class="p-5">
          {
            error && (
              <p class="tm-flash tm-flash--err mb-4 break-words" role="alert">
                {error}
              </p>
            )
          }

          <div class="space-y-3">
            <div class="tm-field" data-required>
              <label class="tm-field-label" for="username">帳號</label>
              <input id="username" name="username" type="text" autocomplete="username" required autofocus />
            </div>

            <div class="tm-field" data-required>
              <label class="tm-field-label" for="password">密碼</label>
              <input id="password" name="password" type="password" autocomplete="current-password" required />
            </div>
          </div>

          <button type="submit" class="tm-btn mt-4 w-full py-2.5">登入</button>
        </form>
      </div>

      <p class="tm-eyebrow mt-4 text-center">僅供內部使用</p>
    </main>
  </body>
</html>
