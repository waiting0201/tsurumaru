---
// 車廠維護。對應舊版 WebMsController 的 CarMakes / MotorMakes 兩套重複程式，
// 這裡合併為單一頁面，以 ?type= 區分（docs/04-conventions.md）。
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import Flash from '../../../components/admin/Flash.astro';
import Field from '../../../components/admin/Field.astro';
import Pager from '../../../components/admin/Pager.astro';
import ScopeTabs from '../../../components/admin/ScopeTabs.astro';
import { requireViewType, requireCanType, requirePost, handleGuard, str, int } from '../../../lib/admin-guard';
import { csrfToken, can, resourceFor } from '../../../lib/auth';
import { listMakes, createMake, updateMake, deleteMake, makeInUse, getMake, updateSorts } from '../../../lib/admin-db';
import { VEHICLE_TYPE } from '../../../lib/enums';

export const prerender = false;

const type = Number(Astro.url.searchParams.get('type')) === VEHICLE_TYPE.BIKE ? VEHICLE_TYPE.BIKE : VEHICLE_TYPE.CAR;
const page = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1);
const typeName = type === VEHICLE_TYPE.CAR ? '汽車' : '機車';

let admin, csrf, data, types: number[] = [], mayAdd = false, mayUpdate = false, mayDelete = false;
let msg = '', err = '';

try {
  // 權限依車種分開，不能寫死成汽車節點（見 auth.ts resourceFor）
  ({ admin, types } = await requireViewType(Astro, 'makes', type));
  csrf = await csrfToken(admin.sessionId);
  const RES = resourceFor('makes', type);

  if (Astro.request.method === 'POST') {
    const form = await requirePost(Astro, admin);
    const action = str(form, 'action');

    if (action === 'create') {
      await requireCanType(Astro, 'makes', type, 'add');
      const code = str(form, 'code'), title = str(form, 'title');
      if (!code || !title) err = '代碼與名稱都是必填。';
      else { await createMake(type, code, title, int(form, 'sort') ?? 0); msg = `已新增「${title}」。`; }
    } else if (action === 'update') {
      await requireCanType(Astro, 'makes', type, 'update');
      const id = int(form, 'id');
      const code = str(form, 'code'), title = str(form, 'title');
      if (!id || !(await getMake(id))) err = '找不到該車廠。';
      else if (!code || !title) err = '代碼與名稱都是必填。';
      else { await updateMake(id, code, title, int(form, 'sort') ?? 0); msg = '已更新。'; }
    } else if (action === 'delete') {
      await requireCanType(Astro, 'makes', type, 'delete');
      const id = int(form, 'id');
      if (!id || !(await getMake(id))) err = '找不到該車廠。';
      else {
        const used = await makeInUse(id);
        if (used > 0) err = `這個車廠底下還有 ${used} 個車型，請先處理車型再刪除。`;
        else { await deleteMake(id); msg = '已刪除。'; }
      }
    } else if (action === 'sort') {
      await requireCanType(Astro, 'makes', type, 'update');
      const ids = form.getAll('sort_id').map((v) => Number(v));
      const sorts = form.getAll('sort_value').map((v) => Number(v));
      await updateSorts('vehicle_makes', ids.map((id, i) => ({ id, sort: sorts[i] ?? 0 })));
      msg = '排序已更新。';
    }
  }

  [data, mayAdd, mayUpdate, mayDelete] = await Promise.all([
    listMakes(type, page),
    can(admin, RES, 'add'),
    can(admin, RES, 'update'),
    can(admin, RES, 'delete'),
  ]);
} catch (e) {
  return handleGuard(e);
}

const editId = Number(Astro.url.searchParams.get('edit')) || 0;
const editing = editId ? data.items.find((m) => m.id === editId) : null;
const qs = (o: Record<string, string | number>) =>
  '?' + new URLSearchParams({ type: String(type), ...Object.fromEntries(Object.entries(o).map(([k, v]) => [k, String(v)])) }).toString();
---

<Admin title={`車廠維護 — ${typeName}`} admin={admin} csrf={csrf}>
  <ScopeTabs slot="actions" base="/admin/makes" current={type} types={types} />

  <Flash err={err} msg={msg} />

  <div class="space-y-5">
    <Panel title={`${typeName}車廠`} flush>
      <span class="font-mono text-[12px] text-ink-mute" slot="head">{data.total.toLocaleString('en-US')} 筆</span>

      {data.items.length === 0 ? (
        <div class="px-5 py-12 text-center">
          <p class="text-[15px] text-ink">還沒有{typeName}車廠。</p>
          <p class="tm-field-hint mx-auto max-w-xs">車廠是車型的上層 —— 先建車廠，才能建車型與車輛。</p>
        </div>
      ) : (
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="sort" />

          <div class="overflow-x-auto">
            <table class="tm-table">
              <thead>
                <tr>
                  <th class="w-20">排序</th>
                  <th class="w-40">代碼</th>
                  <th>名稱</th>
                  <th class="w-24 text-right">操作</th>
                </tr>
              </thead>
              <tbody>
                {data.items.map((m) => (
                  <tr class:list={[editing?.id === m.id && 'bg-paper']}>
                    <td>
                      <input type="hidden" name="sort_id" value={m.id} />
                      <input
                        class="tm-cell-input"
                        type="number"
                        name="sort_value"
                        value={m.sort}
                        disabled={!mayUpdate}
                        aria-label={`${m.title} 的排序`}
                      />
                    </td>
                    <td class="font-mono text-[13px] text-ink-soft">{m.code}</td>
                    <td class="font-medium text-ink">{m.title}</td>
                    <td class="text-right">
                      {mayUpdate && (
                        <a class="tm-btn tm-btn--ghost tm-btn--sm" href={`${qs({ p: page, edit: m.id })}#edit`}>編輯</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {mayUpdate && (
            <div class="flex items-center gap-3 border-t border-rule px-4 py-3">
              <button class="tm-btn" type="submit">儲存排序</button>
              <span class="text-[13px] text-ink-mute">數字小的排在前面。</span>
            </div>
          )}
        </form>
      )}

      <Pager page={data.page} totalPages={data.totalPages} total={data.total} href={(n) => qs({ p: n })} />
    </Panel>

    {mayUpdate && editing && (
      <Panel title={`編輯車廠 — ${editing.title}`} class="scroll-mt-24" id="edit">
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" value={editing.id} />

          <div class="grid gap-3 sm:grid-cols-3">
            <Field label="代碼" for="e-code" required numeric hint="前台網址與篩選用，建議英數。">
              <input id="e-code" name="code" type="text" value={editing.code} required />
            </Field>
            <Field label="名稱" for="e-title" required>
              <input id="e-title" name="title" type="text" value={editing.title} required />
            </Field>
            <Field label="排序" for="e-sort" numeric>
              <input id="e-sort" name="sort" type="number" value={editing.sort} />
            </Field>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button class="tm-btn" type="submit">儲存變更</button>
            <a class="tm-btn tm-btn--ghost" href={qs({ p: page })}>取消</a>
          </div>
        </form>

        {mayDelete && (
          <form
            method="post"
            class="mt-4 flex flex-wrap items-center gap-3 border-t border-rule pt-4"
            onsubmit="return confirm('刪除這個車廠？')"
          >
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={editing.id} />
            <button class="tm-btn tm-btn--danger tm-btn--sm" type="submit">刪除這個車廠</button>
            <span class="text-[13px] text-ink-mute">底下還有車型的車廠不能刪。</span>
          </form>
        )}
      </Panel>
    )}

    {mayAdd && (
      <Panel title={`新增${typeName}車廠`}>
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="create" />

          <div class="grid gap-3 sm:grid-cols-3">
            <Field label="代碼" for="c-code" required numeric hint="前台網址與篩選用，建議英數。">
              <input id="c-code" name="code" type="text" required />
            </Field>
            <Field label="名稱" for="c-title" required>
              <input id="c-title" name="title" type="text" required />
            </Field>
            <Field label="排序" for="c-sort" numeric>
              <input id="c-sort" name="sort" type="number" value="0" />
            </Field>
          </div>

          <div class="mt-4">
            <button class="tm-btn" type="submit">新增車廠</button>
          </div>
        </form>
      </Panel>
    )}
  </div>
</Admin>
