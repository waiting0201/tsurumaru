---
// 車型維護。合併舊版的 CarModels / MotorModels 兩套重複程式。
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import Flash from '../../../components/admin/Flash.astro';
import Field from '../../../components/admin/Field.astro';
import Pager from '../../../components/admin/Pager.astro';
import ScopeTabs from '../../../components/admin/ScopeTabs.astro';
import { requireViewType, requireCanType, requirePost, handleGuard, str, int } from '../../../lib/admin-guard';
import { csrfToken, can, resourceFor } from '../../../lib/auth';
import { listModels, createModel, updateModel, deleteModel, modelInUse, getModelRow, allMakes, updateSorts } from '../../../lib/admin-db';
import { VEHICLE_TYPE } from '../../../lib/enums';

export const prerender = false;

const type = Number(Astro.url.searchParams.get('type')) === VEHICLE_TYPE.BIKE ? VEHICLE_TYPE.BIKE : VEHICLE_TYPE.CAR;
const page = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1);
const makeFilter = Number(Astro.url.searchParams.get('make')) || null;
const typeName = type === VEHICLE_TYPE.CAR ? '汽車' : '機車';

let admin, csrf, data, makes, types: number[] = [], mayAdd = false, mayUpdate = false, mayDelete = false;
let msg = '', err = '';

try {
  // 權限依車種分開，不能寫死成汽車節點（見 auth.ts resourceFor）
  ({ admin, types } = await requireViewType(Astro, 'models', type));
  csrf = await csrfToken(admin.sessionId);
  const RES = resourceFor('models', type);

  if (Astro.request.method === 'POST') {
    const form = await requirePost(Astro, admin);
    const action = str(form, 'action');

    if (action === 'create') {
      await requireCanType(Astro, 'models', type, 'add');
      const makeId = int(form, 'make_id'), code = str(form, 'code'), title = str(form, 'title');
      if (!makeId || !code || !title) err = '車廠、代碼與名稱都是必填。';
      else { await createModel(makeId, code, title, int(form, 'sort') ?? 0); msg = `已新增「${title}」。`; }
    } else if (action === 'update') {
      await requireCanType(Astro, 'models', type, 'update');
      const id = int(form, 'id'), makeId = int(form, 'make_id');
      const code = str(form, 'code'), title = str(form, 'title');
      if (!id || !(await getModelRow(id))) err = '找不到該車型。';
      else if (!makeId || !code || !title) err = '車廠、代碼與名稱都是必填。';
      else { await updateModel(id, makeId, code, title, int(form, 'sort') ?? 0); msg = '已更新。'; }
    } else if (action === 'delete') {
      await requireCanType(Astro, 'models', type, 'delete');
      const id = int(form, 'id');
      if (!id || !(await getModelRow(id))) err = '找不到該車型。';
      else {
        const used = await modelInUse(id);
        if (used > 0) err = `這個車型底下還有 ${used} 台車輛，請先處理車輛再刪除。`;
        else { await deleteModel(id); msg = '已刪除。'; }
      }
    } else if (action === 'sort') {
      await requireCanType(Astro, 'models', type, 'update');
      const ids = form.getAll('sort_id').map((v) => Number(v));
      const sorts = form.getAll('sort_value').map((v) => Number(v));
      await updateSorts('vehicle_models', ids.map((id, i) => ({ id, sort: sorts[i] ?? 0 })));
      msg = '排序已更新。';
    }
  }

  [data, makes, mayAdd, mayUpdate, mayDelete] = await Promise.all([
    listModels(type, makeFilter, page),
    allMakes(type),
    can(admin, RES, 'add'),
    can(admin, RES, 'update'),
    can(admin, RES, 'delete'),
  ]);
} catch (e) {
  return handleGuard(e);
}

const editId = Number(Astro.url.searchParams.get('edit')) || 0;
const editing = editId ? data.items.find((m) => m.id === editId) : null;
const qs = (o: Record<string, string | number>) => {
  const p = new URLSearchParams({ type: String(type) });
  if (makeFilter) p.set('make', String(makeFilter));
  for (const [k, v] of Object.entries(o)) p.set(k, String(v));
  return '?' + p.toString();
};
const filteredMake = makeFilter ? makes.find((m) => m.id === makeFilter) : null;
---

<Admin title={`車型維護 — ${typeName}`} admin={admin} csrf={csrf}>
  <ScopeTabs slot="actions" base="/admin/models" current={type} types={types} />

  <Flash err={err} msg={msg} />

  <div class="space-y-5">
    <Panel title={`${typeName}車型`} flush>
      <Fragment slot="head">
        {/* 篩選跟著列表抬頭走，不佔一整個面板 */}
        <form method="get" class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="type" value={type} />
          <label class="sr-only" for="make-filter">依車廠篩選</label>
          <select
            id="make-filter"
            name="make"
            class="cursor-pointer border border-rule bg-white px-2 py-1.5 text-[13px] text-ink"
          >
            <option value="">全部車廠</option>
            {makes.map((m) => <option value={m.id} selected={makeFilter === m.id}>{m.title}</option>)}
          </select>
          <button class="tm-btn tm-btn--ghost tm-btn--sm" type="submit">篩選</button>
          {filteredMake && <a class="text-[13px] text-ink-mute underline-offset-4 hover:underline" href={qs({ p: 1 })}>清除</a>}
        </form>
        <span class="font-mono text-[12px] text-ink-mute">{data.total.toLocaleString('en-US')} 筆</span>
      </Fragment>

      {data.items.length === 0 ? (
        <div class="px-5 py-12 text-center">
          <p class="text-[15px] text-ink">
            {filteredMake ? `${filteredMake.title} 底下還沒有車型。` : `還沒有${typeName}車型。`}
          </p>
          <p class="tm-field-hint mx-auto max-w-xs">車型要掛在車廠底下 —— 車廠列表在「車廠」頁。</p>
        </div>
      ) : (
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="sort" />

          <div class="overflow-x-auto">
            <table class="tm-table">
              <thead>
                <tr>
                  <th class="w-20">排序</th>
                  <th class="w-44">車廠</th>
                  <th class="w-40">代碼</th>
                  <th>名稱</th>
                  <th class="w-24 text-right">操作</th>
                </tr>
              </thead>
              <tbody>
                {data.items.map((m) => (
                  <tr class:list={[editing?.id === m.id && 'bg-paper']}>
                    <td>
                      <input type="hidden" name="sort_id" value={m.id} />
                      <input
                        class="tm-cell-input"
                        type="number"
                        name="sort_value"
                        value={m.sort}
                        disabled={!mayUpdate}
                        aria-label={`${m.title} 的排序`}
                      />
                    </td>
                    <td class="text-ink-soft">{m.make_title}</td>
                    <td class="font-mono text-[13px] text-ink-soft">{m.code}</td>
                    <td class="font-medium text-ink">{m.title}</td>
                    <td class="text-right">
                      {mayUpdate && (
                        <a class="tm-btn tm-btn--ghost tm-btn--sm" href={`${qs({ p: page, edit: m.id })}#edit`}>編輯</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {mayUpdate && (
            <div class="flex items-center gap-3 border-t border-rule px-4 py-3">
              <button class="tm-btn" type="submit">儲存排序</button>
              <span class="text-[13px] text-ink-mute">數字小的排在前面。</span>
            </div>
          )}
        </form>
      )}

      <Pager page={data.page} totalPages={data.totalPages} total={data.total} href={(n) => qs({ p: n })} />
    </Panel>

    {mayUpdate && editing && (
      <Panel title={`編輯車型 — ${editing.title}`} class="scroll-mt-24" id="edit">
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="update" />
          <input type="hidden" name="id" value={editing.id} />

          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <Field label="車廠" for="e-make" required>
              <select id="e-make" name="make_id" required>
                {makes.map((m) => <option value={m.id} selected={m.id === editing.vehicle_make_id}>{m.title}</option>)}
              </select>
            </Field>
            <Field label="代碼" for="e-code" required numeric hint="前台網址與篩選用，建議英數。">
              <input id="e-code" name="code" type="text" value={editing.code} required />
            </Field>
            <Field label="名稱" for="e-title" required>
              <input id="e-title" name="title" type="text" value={editing.title} required />
            </Field>
            <Field label="排序" for="e-sort" numeric>
              <input id="e-sort" name="sort" type="number" value={editing.sort} />
            </Field>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button class="tm-btn" type="submit">儲存變更</button>
            <a class="tm-btn tm-btn--ghost" href={qs({ p: page })}>取消</a>
          </div>
        </form>

        {mayDelete && (
          <form
            method="post"
            class="mt-4 flex flex-wrap items-center gap-3 border-t border-rule pt-4"
            onsubmit="return confirm('刪除這個車型？')"
          >
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={editing.id} />
            <button class="tm-btn tm-btn--danger tm-btn--sm" type="submit">刪除這個車型</button>
            <span class="text-[13px] text-ink-mute">底下還有車輛的車型不能刪。</span>
          </form>
        )}
      </Panel>
    )}

    {mayAdd && (
      <Panel title={`新增${typeName}車型`}>
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="create" />

          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <Field label="車廠" for="c-make" required>
              <select id="c-make" name="make_id" required>
                <option value="">請選擇</option>
                {makes.map((m) => <option value={m.id}>{m.title}</option>)}
              </select>
            </Field>
            <Field label="代碼" for="c-code" required numeric hint="前台網址與篩選用，建議英數。">
              <input id="c-code" name="code" type="text" required />
            </Field>
            <Field label="名稱" for="c-title" required>
              <input id="c-title" name="title" type="text" required />
            </Field>
            <Field label="排序" for="c-sort" numeric>
              <input id="c-sort" name="sort" type="number" value="0" />
            </Field>
          </div>

          <div class="mt-4">
            <button class="tm-btn" type="submit">新增車型</button>
          </div>
        </form>
      </Panel>
    )}
  </div>
</Admin>
