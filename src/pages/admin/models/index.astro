---
// 車型維護。合併舊版的 CarModels / MotorModels 兩套重複程式。
import Admin from '../../../layouts/Admin.astro';
import { requireView, requireCan, requirePost, handleGuard, str, int } from '../../../lib/admin-guard';
import { csrfToken, RESOURCES, can } from '../../../lib/auth';
import { listModels, createModel, updateModel, deleteModel, modelInUse, getModelRow, allMakes, updateSorts } from '../../../lib/admin-db';
import { VEHICLE_TYPE } from '../../../lib/enums';

export const prerender = false;

const type = Number(Astro.url.searchParams.get('type')) === VEHICLE_TYPE.BIKE ? VEHICLE_TYPE.BIKE : VEHICLE_TYPE.CAR;
const page = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1);
const makeFilter = Number(Astro.url.searchParams.get('make')) || null;
const typeName = type === VEHICLE_TYPE.CAR ? '汽車' : '機車';

let admin, csrf, data, makes, mayAdd = false, mayUpdate = false, mayDelete = false;
let msg = '', err = '';

try {
  admin = await requireView(Astro, RESOURCES.MODELS);
  csrf = await csrfToken(admin.sessionId);

  if (Astro.request.method === 'POST') {
    const form = await requirePost(Astro, admin);
    const action = str(form, 'action');

    if (action === 'create') {
      await requireCan(Astro, RESOURCES.MODELS, 'add');
      const makeId = int(form, 'make_id'), code = str(form, 'code'), title = str(form, 'title');
      if (!makeId || !code || !title) err = '車廠、代碼與名稱都是必填。';
      else { await createModel(makeId, code, title, int(form, 'sort') ?? 0); msg = `已新增「${title}」。`; }
    } else if (action === 'update') {
      await requireCan(Astro, RESOURCES.MODELS, 'update');
      const id = int(form, 'id'), makeId = int(form, 'make_id');
      const code = str(form, 'code'), title = str(form, 'title');
      if (!id || !(await getModelRow(id))) err = '找不到該車型。';
      else if (!makeId || !code || !title) err = '車廠、代碼與名稱都是必填。';
      else { await updateModel(id, makeId, code, title, int(form, 'sort') ?? 0); msg = '已更新。'; }
    } else if (action === 'delete') {
      await requireCan(Astro, RESOURCES.MODELS, 'delete');
      const id = int(form, 'id');
      if (!id || !(await getModelRow(id))) err = '找不到該車型。';
      else {
        const used = await modelInUse(id);
        if (used > 0) err = `這個車型底下還有 ${used} 台車輛，請先處理車輛再刪除。`;
        else { await deleteModel(id); msg = '已刪除。'; }
      }
    } else if (action === 'sort') {
      await requireCan(Astro, RESOURCES.MODELS, 'update');
      const ids = form.getAll('sort_id').map((v) => Number(v));
      const sorts = form.getAll('sort_value').map((v) => Number(v));
      await updateSorts('vehicle_models', ids.map((id, i) => ({ id, sort: sorts[i] ?? 0 })));
      msg = '排序已更新。';
    }
  }

  [data, makes, mayAdd, mayUpdate, mayDelete] = await Promise.all([
    listModels(type, makeFilter, page),
    allMakes(type),
    can(admin, RESOURCES.MODELS, 'add'),
    can(admin, RESOURCES.MODELS, 'update'),
    can(admin, RESOURCES.MODELS, 'delete'),
  ]);
} catch (e) {
  return handleGuard(e);
}

const editId = Number(Astro.url.searchParams.get('edit')) || 0;
const editing = editId ? data.items.find((m) => m.id === editId) : null;
const qs = (o: Record<string, string | number>) => {
  const p = new URLSearchParams({ type: String(type) });
  if (makeFilter) p.set('make', String(makeFilter));
  for (const [k, v] of Object.entries(o)) p.set(k, String(v));
  return '?' + p.toString();
};
---
<Admin title={`車型維護 — ${typeName}`} admin={admin} csrf={csrf}>
  {err && <div class="msg err">{err}</div>}
  {msg && <div class="msg ok">{msg}</div>}

  <div class="panel">
    <form method="get" class="actions" style="margin-bottom:1rem">
      <input type="hidden" name="type" value={type}>
      <a class="btn secondary sm" href="/admin/models?type=1">汽車</a>
      <a class="btn secondary sm" href="/admin/models?type=2">機車</a>
      <select name="make" style="width:14rem">
        <option value="">全部車廠</option>
        {makes.map((m) => <option value={m.id} selected={makeFilter === m.id}>{m.title}</option>)}
      </select>
      <button class="btn secondary sm" type="submit">篩選</button>
      <span class="muted">共 {data.total} 筆</span>
    </form>

    <form method="post">
      <input type="hidden" name="csrf" value={csrf}>
      <input type="hidden" name="action" value="sort">
      <div class="table-wrap">
        <table>
          <thead><tr><th style="width:6rem">排序</th><th>車廠</th><th>代碼</th><th>名稱</th><th style="width:8rem">操作</th></tr></thead>
          <tbody>
            {data.items.map((m) => (
              <tr>
                <td>
                  <input type="hidden" name="sort_id" value={m.id}>
                  <input type="number" name="sort_value" value={m.sort} disabled={!mayUpdate} style="width:5rem">
                </td>
                <td>{m.make_title}</td>
                <td>{m.code}</td>
                <td>{m.title}</td>
                <td>{mayUpdate && <a class="btn secondary sm" href={qs({ p: page, edit: m.id })}>編輯</a>}</td>
              </tr>
            ))}
            {data.items.length === 0 && <tr><td colspan="5" class="muted">沒有資料。</td></tr>}
          </tbody>
        </table>
      </div>
      {mayUpdate && data.items.length > 0 && (
        <div style="margin-top:1rem"><button class="btn" type="submit">儲存排序</button></div>
      )}
    </form>

    <div class="pager">
      {Array.from({ length: data.totalPages }, (_, i) => i + 1).map((n) => (
        n === data.page ? <span aria-current="page">{n}</span> : <a href={qs({ p: n })}>{n}</a>
      ))}
    </div>
  </div>

  {(mayUpdate && editing) && (
    <div class="panel">
      <h2 style="font-size:1.1rem;margin-top:0">編輯車型</h2>
      <form method="post">
        <input type="hidden" name="csrf" value={csrf}>
        <input type="hidden" name="action" value="update">
        <input type="hidden" name="id" value={editing.id}>
        <div class="grid">
          <div><label for="e-make">車廠</label>
            <select id="e-make" name="make_id" required>
              {makes.map((m) => <option value={m.id} selected={m.id === editing.vehicle_make_id}>{m.title}</option>)}
            </select></div>
          <div><label for="e-code">代碼</label><input id="e-code" name="code" type="text" value={editing.code} required></div>
          <div><label for="e-title">名稱</label><input id="e-title" name="title" type="text" value={editing.title} required></div>
          <div><label for="e-sort">排序</label><input id="e-sort" name="sort" type="number" value={editing.sort}></div>
        </div>
        <div class="actions" style="margin-top:1rem">
          <button class="btn" type="submit">儲存</button>
          <a class="btn secondary" href={qs({ p: page })}>取消</a>
        </div>
      </form>
      {mayDelete && (
        <form method="post" style="margin-top:1rem" onsubmit="return confirm('確定刪除這個車型？')">
          <input type="hidden" name="csrf" value={csrf}>
          <input type="hidden" name="action" value="delete">
          <input type="hidden" name="id" value={editing.id}>
          <button class="btn danger sm" type="submit">刪除這個車型</button>
        </form>
      )}
    </div>
  )}

  {mayAdd && (
    <div class="panel">
      <h2 style="font-size:1.1rem;margin-top:0">新增{typeName}車型</h2>
      <form method="post">
        <input type="hidden" name="csrf" value={csrf}>
        <input type="hidden" name="action" value="create">
        <div class="grid">
          <div><label for="c-make">車廠</label>
            <select id="c-make" name="make_id" required>
              <option value="">請選擇</option>
              {makes.map((m) => <option value={m.id}>{m.title}</option>)}
            </select></div>
          <div><label for="c-code">代碼</label><input id="c-code" name="code" type="text" required></div>
          <div><label for="c-title">名稱</label><input id="c-title" name="title" type="text" required></div>
          <div><label for="c-sort">排序</label><input id="c-sort" name="sort" type="number" value="0"></div>
        </div>
        <div style="margin-top:1rem"><button class="btn" type="submit">新增</button></div>
      </form>
    </div>
  )}
</Admin>
