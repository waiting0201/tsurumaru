---
// 車輛新增／編輯。合併舊版的 AddCars / EditCars / AddMotors / EditMotors 四個 action。
//
// 上傳與舊版的差異（docs/08-security.md）：
//   • 副檔名白名單 + 驗證 magic bytes（不信任 Content-Type）
//   • 大小上限
//   • 檔名重新產生，不沿用使用者輸入
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import Flash from '../../../components/admin/Flash.astro';
import Field from '../../../components/admin/Field.astro';
import { requireViewType, requireCanType, requirePost, handleGuard, str, int } from '../../../lib/admin-guard';
import { csrfToken } from '../../../lib/auth';
import { getVehicleRow, insertVehicle, updateVehicle, modelsForType } from '../../../lib/admin-db';
import {
  putVehiclePhoto, deleteVehiclePhoto, newPhotoFilename,
  ALLOWED_IMAGE_TYPES, MAX_UPLOAD_BYTES, sniffImageType, photoUrl,
} from '../../../lib/media';
import { VEHICLE_TYPE, VEHICLE_BODY, FUEL, DRIVELINE, TRANSMISSION, EXTERIOR_COLORS } from '../../../lib/enums';

export const prerender = false;

const type = Number(Astro.url.searchParams.get('type')) === VEHICLE_TYPE.BIKE ? VEHICLE_TYPE.BIKE : VEHICLE_TYPE.CAR;
const editId = Astro.url.searchParams.get('id');
const typeName = type === VEHICLE_TYPE.CAR ? '汽車' : '機車';

let admin, csrf, models, vehicle = null;
let err = '', msg = '';

try {
  // 權限依車種分開，不能寫死成汽車節點（見 auth.ts resourceFor）
  ({ admin } = await requireViewType(Astro, 'vehicles', type));
  csrf = await csrfToken(admin.sessionId);
  vehicle = editId ? await getVehicleRow(editId) : null;
  if (editId && !vehicle) return new Response('404 — 找不到該車輛。', { status: 404 });

  if (Astro.request.method === 'POST') {
    await requireCanType(Astro, 'vehicles', type, vehicle ? 'update' : 'add');
    const form = await requirePost(Astro, admin);

    const modelId = int(form, 'vehicle_model_id');
    const price = int(form, 'price');
    if (!modelId) err = '請選擇車型。';
    else if (price == null || price < 0) err = '請填寫有效的價格。';
    else {
      const id = vehicle?.id ?? crypto.randomUUID().toLowerCase();
      let photoName = vehicle?.photo ?? '';

      const file = form.get('photo');
      if (file instanceof File && file.size > 0) {
        if (file.size > MAX_UPLOAD_BYTES) {
          err = `圖片超過上限 ${(MAX_UPLOAD_BYTES / 1024 / 1024).toFixed(0)} MB。`;
        } else {
          const buf = await file.arrayBuffer();
          const sniffed = sniffImageType(buf);
          if (!sniffed || !ALLOWED_IMAGE_TYPES[sniffed]) {
            err = '只接受 JPG／PNG／WebP／GIF 圖片。';
          } else {
            const name = newPhotoFilename(`x.${ALLOWED_IMAGE_TYPES[sniffed]}`);
            await putVehiclePhoto(id, name, buf, sniffed);
            if (vehicle?.photo && vehicle.photo !== name) await deleteVehiclePhoto(id, vehicle.photo);
            photoName = name;
          }
        }
      }

      if (!err && !photoName) err = '請上傳主圖。';

      if (!err) {
        const data = {
          id, vehicle_model_id: modelId, type,
          year: int(form, 'year'), fuel: int(form, 'fuel'), mileage: int(form, 'mileage'),
          vehicle_type: str(form, 'vehicle_type') || null,
          driveline: str(form, 'driveline') || null,
          exterior: str(form, 'exterior') || null,
          interior: str(form, 'interior') || null,
          engine: str(form, 'engine') || null,
          transmission: str(form, 'transmission') || null,
          cc: int(form, 'cc'), location: str(form, 'location') || null, vin: str(form, 'vin') || null,
          summary: str(form, 'summary') || null, description: str(form, 'description') || null,
          photo: photoName, price, sort: int(form, 'sort') ?? 0,
        };
        if (vehicle) { await updateVehicle(data); }
        else { await insertVehicle(data, new Date().toISOString().slice(0, 19) + 'Z'); }
        return Astro.redirect(`/admin/vehicles?type=${type}`, 302);
      }
    }
  }

  models = await modelsForType(type);
} catch (e) {
  return handleGuard(e);
}

const v = vehicle;
const val = (k: keyof NonNullable<typeof v>) => (v ? (v[k] ?? '') : '');
const backHref = `/admin/vehicles?type=${type}`;
const frontHref = v ? `${type === VEHICLE_TYPE.CAR ? '/cars' : '/bikes'}/${v.id}` : '';
const maxMb = (MAX_UPLOAD_BYTES / 1024 / 1024).toFixed(0);
const fieldGrid = 'grid gap-3 sm:grid-cols-2 xl:grid-cols-3';
---

<Admin title={`${v ? '編輯' : '新增'}${typeName}`} admin={admin} csrf={csrf}>
  <Fragment slot="actions">
    {v && <a class="tm-btn tm-btn--ghost" href={`/admin/vehicles/photos?id=${v.id}`}>相簿</a>}
    {v && <a class="tm-btn tm-btn--ghost" href={frontHref} target="_blank" rel="noopener">前台 ↗</a>}
  </Fragment>

  <Flash err={err} msg={msg} />

  <form method="post" enctype="multipart/form-data">
    <input type="hidden" name="csrf" value={csrf} />

    <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <!-- ── 左欄：資料 ─────────────────────────────────────────────── -->
      <div class="space-y-5">
        <Panel title="基本">
          <div class={fieldGrid}>
            <Field label="車型" for="model" required class="sm:col-span-2 xl:col-span-1">
              <select id="model" name="vehicle_model_id" required>
                <option value="">請選擇</option>
                {models.map((m) => (
                  <option value={m.id} selected={v?.vehicle_model_id === m.id}>{m.make_title} — {m.title}</option>
                ))}
              </select>
            </Field>

            <Field label="價格（日圓）" for="price" required numeric>
              <input id="price" name="price" type="number" min="0" value={val('price')} required />
            </Field>

            <Field label="出廠年份" for="year" numeric>
              <input id="year" name="year" type="number" value={val('year')} />
            </Field>

            <Field label="里程（公里）" for="mileage" numeric>
              <input id="mileage" name="mileage" type="number" value={val('mileage')} />
            </Field>

            <Field label="排氣量 CC" for="cc" numeric>
              <input id="cc" name="cc" type="number" value={val('cc')} />
            </Field>

            <Field label="排序" for="sort" numeric hint="數字小的排在前面。">
              <input id="sort" name="sort" type="number" value={v ? v.sort : 0} />
            </Field>
          </div>
        </Panel>

        <Panel title="規格">
          <div class={fieldGrid}>
            <Field label="車種" for="vehicle_type">
              <select id="vehicle_type" name="vehicle_type">
                <option value="">未指定</option>
                {Object.entries(VEHICLE_BODY).map(([k, t]) => (
                  <option value={k} selected={v?.vehicle_type === k}>{t}</option>
                ))}
              </select>
            </Field>

            <Field label="燃料" for="fuel">
              <select id="fuel" name="fuel">
                <option value="">未指定</option>
                {Object.entries(FUEL).map(([k, t]) => (
                  <option value={k} selected={String(v?.fuel ?? '') === k}>{t}</option>
                ))}
              </select>
            </Field>

            <Field label="傳動系統" for="driveline">
              <select id="driveline" name="driveline">
                <option value="">未指定</option>
                {Object.entries(DRIVELINE).map(([k, t]) => (
                  <option value={k} selected={v?.driveline === k}>{t}</option>
                ))}
              </select>
            </Field>

            <Field label="變速器" for="transmission">
              <select id="transmission" name="transmission">
                <option value="">未指定</option>
                {Object.entries(TRANSMISSION).map(([k, t]) => (
                  <option value={k} selected={v?.transmission === k}>{t}</option>
                ))}
              </select>
            </Field>

            <Field label="外觀顏色" for="exterior">
              <select id="exterior" name="exterior">
                <option value="">未指定</option>
                {EXTERIOR_COLORS.map((c) => <option value={c} selected={v?.exterior === c}>{c}</option>)}
              </select>
            </Field>

            <Field label="內裝" for="interior">
              <input id="interior" name="interior" type="text" value={val('interior')} />
            </Field>

            <Field label="發動機" for="engine">
              <input id="engine" name="engine" type="text" value={val('engine')} />
            </Field>

            <Field label="所在地" for="location">
              <input id="location" name="location" type="text" value={val('location')} />
            </Field>

            <Field label="車身號碼 VIN" for="vin" numeric>
              <input id="vin" name="vin" type="text" value={val('vin')} spellcheck="false" />
            </Field>
          </div>
        </Panel>

        <Panel title="說明">
          <div class="space-y-3">
            <Field label="摘要" for="summary" hint="列表卡片上的一句話。">
              <textarea id="summary" name="summary">{val('summary')}</textarea>
            </Field>

            <Field label="詳細說明" for="description" hint="前台詳情頁的內容，可含 HTML 標籤。">
              <textarea id="description" name="description" class="min-h-48">{val('description')}</textarea>
            </Field>
          </div>
        </Panel>
      </div>

      <!-- ── 右欄：主圖 ─────────────────────────────────────────────────
           填規格的時候要能一直看到這台車長什麼樣，所以釘在旁邊不隨著捲動走。 -->
      <div class="lg:sticky lg:top-24">
        <Panel title="主圖">
          {v?.photo ? (
            <img class="tm-thumb mb-3 aspect-3/2 w-full" src={photoUrl(v.id, v.photo)} alt="目前的主圖" />
          ) : (
            <div class="mb-3 grid aspect-3/2 w-full place-items-center border border-dashed border-rule bg-paper">
              <span class="tm-eyebrow">尚無主圖</span>
            </div>
          )}

          <input
            id="photo"
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/gif"
            class="w-full text-[13px] text-ink-soft file:mr-2 file:cursor-pointer file:border file:border-rule file:bg-white file:px-2.5 file:py-1.5 file:text-[13px] file:text-ink hover:file:border-ink"
          />
          <p class="tm-field-hint">
            {v ? '不選檔案就沿用現有主圖。' : '主圖是必填的。'}
            接受 JPG／PNG／WebP／GIF，上限 {maxMb} MB。本站不做即時縮圖，請先壓過再上傳（建議寬度 1600px 以內）。
          </p>
        </Panel>

        {v && (
          <dl class="mt-5 border border-rule bg-white px-4 py-3 text-[13px]">
            <dt class="tm-eyebrow">記錄編號</dt>
            <dd class="mt-1 font-mono text-[12px] break-all text-ink-soft">{v.id}</dd>
          </dl>
        )}
      </div>
    </div>

    <!-- 表單很長，存檔鈕跟著畫面走，不用捲回去找 -->
    <div class="tm-actionbar mt-5">
      <button class="tm-btn" type="submit">{v ? '儲存變更' : `新增${typeName}`}</button>
      <a class="tm-btn tm-btn--ghost" href={backHref}>取消</a>
      <span class="ml-auto flex items-center gap-1.5 text-[13px] text-ink-mute">
        <span class="size-1.5 bg-stamp" aria-hidden="true"></span>必填
      </span>
    </div>
  </form>
</Admin>
