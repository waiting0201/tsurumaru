---
// 車輛相簿。合併舊版的 CarPhotos / MotorPhotos 兩套重複程式。
//
// ⚠️ 舊版的權限樹根本沒有相簿節點，導致這個功能對所有一般管理員都是壞的
//    （會撞到一個沒有解釋的 404）。搬遷時已補上 Photos 節點。
//    見 docs/08-security.md#相簿管理對一般管理員完全不可用
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import Flash from '../../../components/admin/Flash.astro';
import { requireView, requireCan, requirePost, handleGuard, str } from '../../../lib/admin-guard';
import { csrfToken, RESOURCES, can } from '../../../lib/auth';
import { getVehicleRow, listPhotos, insertPhoto, updatePhotoMeta, deletePhotoRow, getPhoto, nextPhotoSort } from '../../../lib/admin-db';
import {
  putVehiclePhoto, deleteVehiclePhoto, newPhotoFilename, photoUrl,
  ALLOWED_IMAGE_TYPES, MAX_UPLOAD_BYTES, sniffImageType,
} from '../../../lib/media';
import { VEHICLE_TYPE } from '../../../lib/enums';

export const prerender = false;

const vehicleId = Astro.url.searchParams.get('id') ?? '';

let admin, csrf, vehicle, photos: Awaited<ReturnType<typeof listPhotos>> = [];
let mayAdd = false, mayUpdate = false, mayDelete = false;
let err = '', msg = '';

try {
  admin = await requireView(Astro, RESOURCES.PHOTOS);
  csrf = await csrfToken(admin.sessionId);

  vehicle = vehicleId ? await getVehicleRow(vehicleId) : null;
  if (!vehicle) return new Response('404 — 找不到該車輛。', { status: 404 });

  if (Astro.request.method === 'POST') {
    const form = await requirePost(Astro, admin);
    const action = str(form, 'action');

    if (action === 'upload') {
      await requireCan(Astro, RESOURCES.PHOTOS, 'add');
      const files = form.getAll('photos').filter((f): f is File => f instanceof File && f.size > 0);
      if (!files.length) err = '請選擇要上傳的圖片。';
      let added = 0;
      // sort 要接在既有相片後面。這裡必須實際查一次 —— photos 變數到函式
      // 尾端才被賦值，在這個時間點還是空陣列，拿它算會讓每一批都從 0 重排，
      // 跟既有相片撞值。
      let sort = await nextPhotoSort(vehicle.id);
      for (const file of files) {
        if (file.size > MAX_UPLOAD_BYTES) { err = `有檔案超過 ${(MAX_UPLOAD_BYTES / 1024 / 1024).toFixed(0)} MB 上限，已略過。`; continue; }
        const buf = await file.arrayBuffer();
        const sniffed = sniffImageType(buf);
        if (!sniffed || !ALLOWED_IMAGE_TYPES[sniffed]) { err = '有檔案不是支援的圖片格式，已略過。'; continue; }
        const name = newPhotoFilename(`x.${ALLOWED_IMAGE_TYPES[sniffed]}`);
        await putVehiclePhoto(vehicle.id, name, buf, sniffed);
        await insertPhoto({
          id: crypto.randomUUID().toLowerCase(), vehicle_id: vehicle.id,
          photo: name, title: null, sort,
        });
        sort += 5;
        added++;
      }
      if (added) msg = `已上傳 ${added} 張。`;
    } else if (action === 'update') {
      await requireCan(Astro, RESOURCES.PHOTOS, 'update');
      const ids = form.getAll('photo_id').map(String);
      const titles = form.getAll('photo_title').map(String);
      const sorts = form.getAll('photo_sort').map((v) => Number(v));
      for (let i = 0; i < ids.length; i++) {
        const row = await getPhoto(ids[i]);
        if (row && row.vehicle_id === vehicle.id) {
          await updatePhotoMeta(ids[i], titles[i]?.trim() || null, sorts[i] ?? 0);
        }
      }
      msg = '已更新。';
    } else if (action === 'delete') {
      await requireCan(Astro, RESOURCES.PHOTOS, 'delete');
      const id = str(form, 'photo_id');
      const row = id ? await getPhoto(id) : null;
      // 必須確認這張相片確實屬於這台車，不能只信任表單傳來的 id
      if (!row || row.vehicle_id !== vehicle.id) err = '找不到該相片。';
      else { await deleteVehiclePhoto(vehicle.id, row.photo); await deletePhotoRow(row.id); msg = '已刪除。'; }
    }
  }

  [photos, mayAdd, mayUpdate, mayDelete] = await Promise.all([
    listPhotos(vehicle.id),
    can(admin, RESOURCES.PHOTOS, 'add'),
    can(admin, RESOURCES.PHOTOS, 'update'),
    can(admin, RESOURCES.PHOTOS, 'delete'),
  ]);
} catch (e) {
  return handleGuard(e);
}

const typeName = vehicle.type === VEHICLE_TYPE.CAR ? '汽車' : '機車';
const backHref = `/admin/vehicles?type=${vehicle.type}`;
const frontHref = `${vehicle.type === VEHICLE_TYPE.CAR ? '/cars' : '/bikes'}/${vehicle.id}`;
const maxMb = (MAX_UPLOAD_BYTES / 1024 / 1024).toFixed(0);
---

<Admin title={`相簿 — ${typeName} ${vehicle.id.slice(0, 8).toUpperCase()}`} admin={admin} csrf={csrf}>
  <Fragment slot="actions">
    <a class="tm-btn tm-btn--ghost" href={backHref}>← 車輛列表</a>
    <a class="tm-btn tm-btn--ghost" href={`/admin/vehicles/edit?type=${vehicle.type}&id=${vehicle.id}`}>編輯車輛</a>
    <a class="tm-btn tm-btn--ghost" href={frontHref} target="_blank" rel="noopener">前台 ↗</a>
  </Fragment>

  <Flash err={err} msg={msg} />

  <div class="space-y-5">
    {mayAdd && (
      <Panel title="上傳相片">
        <form method="post" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="upload" />
          <input
            name="photos"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/gif"
            multiple
            required
            aria-label="選擇要上傳的圖片"
            class="min-w-0 flex-1 text-[13px] text-ink-soft file:mr-2 file:cursor-pointer file:border file:border-rule file:bg-white file:px-2.5 file:py-1.5 file:text-[13px] file:text-ink hover:file:border-ink"
          />
          <button class="tm-btn" type="submit">上傳</button>
        </form>
        <p class="tm-field-hint">可一次選多張。接受 JPG／PNG／WebP／GIF，單檔上限 {maxMb} MB。</p>
      </Panel>
    )}

    <Panel title="相片" flush>
      <span class="font-mono text-[12px] text-ink-mute" slot="head">{photos.length} 張</span>

      {photos.length === 0 ? (
        <div class="px-5 py-12 text-center">
          <p class="text-[15px] text-ink">這台車還沒有相簿照片。</p>
          <p class="tm-field-hint mx-auto max-w-xs">
            {mayAdd ? '從上面的「上傳相片」加入，前台詳情頁的圖庫就會出現。' : '請有上傳權限的管理員加入相片。'}
          </p>
        </div>
      ) : (
        <form method="post">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="action" value="update" />

          {/* 相片用格狀排列，不用表格 —— 一列一張的表格看不出整組相簿的樣子 */}
          <div class="grid gap-px bg-rule sm:grid-cols-2 xl:grid-cols-3">
            {photos.map((p, i) => (
              <article class="bg-white p-3">
                <img
                  class="tm-thumb aspect-3/2 w-full"
                  src={photoUrl(vehicle.id, p.photo)}
                  alt={p.title ?? `第 ${i + 1} 張`}
                  loading="lazy"
                />

                <input type="hidden" name="photo_id" value={p.id} />

                <div class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_5.5rem]">
                  <label class="block">
                    <span class="tm-eyebrow">圖說</span>
                    <input
                      class="tm-cell-input mt-1 font-sans text-[14px]"
                      type="text"
                      name="photo_title"
                      value={p.title ?? ''}
                      disabled={!mayUpdate}
                      placeholder="選填"
                    />
                  </label>
                  <label class="block">
                    <span class="tm-eyebrow">排序</span>
                    <input class="tm-cell-input mt-1" type="number" name="photo_sort" value={p.sort} disabled={!mayUpdate} />
                  </label>
                </div>

                {mayDelete && (
                  <div class="mt-2 flex justify-end">
                    {/* 指向格線外面那張刪除表單 —— 表單不能互相嵌套 */}
                    <button
                      class="tm-btn tm-btn--danger tm-btn--sm"
                      type="submit"
                      form="tm-delete-photo"
                      name="photo_id"
                      value={p.id}
                    >
                      刪除這張
                    </button>
                  </div>
                )}
              </article>
            ))}
          </div>

          {mayUpdate && (
            <div class="flex items-center gap-3 border-t border-rule px-4 py-3">
              <button class="tm-btn" type="submit">儲存圖說與排序</button>
              <span class="text-[13px] text-ink-mute">數字小的排在前面。</span>
            </div>
          )}
        </form>
      )}
    </Panel>
  </div>

  {mayDelete && (
    <form method="post" id="tm-delete-photo" onsubmit="return confirm('刪除這張相片？無法復原。')">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="action" value="delete" />
    </form>
  )}
</Admin>
